[Unit]
Description=GB10 dynamic clock governor v2 (SparkCluster, die 65C / board ceiling 92C)
Documentation=file:///home/oliver/Development/SparkCluster/dgx-spark-dynamic-clocks/README.md

[Service]
Type=simple
User=root
Restart=on-failure
RestartSec=5
ExecStart=/usr/bin/python3 /home/oliver/gb10-clock-governor.py --target 65 --ceiling 92

[Install]
WantedBy=multi-user.target
